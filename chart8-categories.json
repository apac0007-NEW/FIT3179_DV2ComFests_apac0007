{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bar chart of the number of events by kind of event",
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Source Serif 4",
    "axis": {
      "labelFont": "Source Serif 4",
      "titleFont": "Source Serif 4",
      "domain": false,
      "tickSize": 0,
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#39425a",
      "titleColor": "#39425a",
      "gridColor": "#e8ebf3",
      "labelPadding": 6,
      "titlePadding": 10
    },
    "legend": {
      "labelFont": "Source Serif 4",
      "titleFont": "Source Serif 4",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "labelColor": "#39425a",
      "titleColor": "#39425a"
    },
    "text": {
      "font": "Source Serif 4"
    }
  },
  "height": 330,
  "data": {
    "url": "categories.json"
  },
  "encoding": {
    "y": {
      "field": "category",
      "type": "nominal",
      "sort": "-x",
      "title": null
    },
    "x": {
      "field": "n",
      "type": "quantitative",
      "title": "Events",
      "scale": {
        "domain": [
          0,
          1150
        ]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": {
          "band": 0.72
        }
      },
      "encoding": {
        "color": {
          "field": "category",
          "type": "nominal",
          "scale": {
            "domain": [
              "Festivals & markets",
              "Arts & culture",
              "Fitness & wellbeing",
              "Nature & green",
              "Workshops & tours",
              "Library",
              "Family",
              "Other"
            ],
            "range": [
              "#c2306b",
              "#7a4bd1",
              "#138a8a",
              "#5aa02c",
              "#f2a900",
              "#4d8be8",
              "#e8743b",
              "#9aa3b5"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "category",
            "type": "nominal",
            "title": "Kind"
          },
          {
            "field": "n",
            "type": "quantitative",
            "title": "Events"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 13,
        "fontWeight": 600,
        "color": "#1d2540"
      },
      "encoding": {
        "text": {
          "field": "n",
          "type": "quantitative"
        }
      }
    }
  ],
  "width": "container",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}