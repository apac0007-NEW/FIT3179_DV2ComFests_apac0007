{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Night map of Brisbane: event venues as glowing circles, festival and market venues in magenta",
  "config": {
    "view": {
      "stroke": null,
      "fill": "#0e1a33"
    },
    "font": "Source Serif 4",
    "axis": {
      "labelFont": "Source Serif 4",
      "titleFont": "Source Serif 4",
      "domain": false,
      "tickSize": 0,
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#39425a",
      "titleColor": "#39425a",
      "gridColor": "#e8ebf3",
      "labelPadding": 6,
      "titlePadding": 10
    },
    "legend": {
      "labelFont": "Source Serif 4",
      "titleFont": "Source Serif 4",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "labelColor": "#39425a",
      "titleColor": "#39425a"
    },
    "text": {
      "font": "Source Serif 4"
    }
  },
  "usermeta": {
    "map": true,
    "w0": 560,
    "h0": 470,
    "scale0": 72498
  },
  "width": 560,
  "height": 470,
  "projection": {
    "type": "mercator",
    "center": [
      153.055,
      -27.47
    ],
    "scale": 72498
  },
  "layer": [
    {
      "data": {
        "url": "states.geojson",
        "format": {
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#1f3259",
        "stroke": "#3b5384",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "venues.json"
      },
      "mark": {
        "type": "circle",
        "opacity": 0.55,
        "stroke": "#bff3e6",
        "strokeWidth": 0.6,
        "color": "#2fd1b5"
      },
      "encoding": {
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "size": {
          "field": "n",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              276
            ],
            "range": [
              14,
              700
            ]
          },
          "legend": {
            "title": "Events at a venue",
            "orient": "bottom",
            "direction": "horizontal",
            "values": [
              10,
              100,
              250
            ],
            "symbolFillColor": "#2fd1b5",
            "symbolOpacity": 0.7
          }
        },
        "tooltip": [
          {
            "field": "venue",
            "type": "nominal",
            "title": "Venue"
          },
          {
            "field": "venueType",
            "type": "nominal",
            "title": "Type"
          },
          {
            "field": "n",
            "type": "quantitative",
            "title": "Events"
          }
        ]
      }
    },
    {
      "data": {
        "url": "venues_festival.json"
      },
      "mark": {
        "type": "circle",
        "opacity": 0.95,
        "stroke": "#fff",
        "strokeWidth": 1.6,
        "color": "#ff3d8b"
      },
      "encoding": {
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "size": {
          "field": "n",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              276
            ],
            "range": [
              60,
              700
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "venue",
            "type": "nominal",
            "title": "Festival or market venue"
          },
          {
            "field": "n",
            "type": "quantitative",
            "title": "Festival and market events"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "name": "Chermside",
            "lat": -27.386,
            "lon": 153.034
          },
          {
            "name": "Indooroopilly",
            "lat": -27.5,
            "lon": 152.973
          },
          {
            "name": "Carindale",
            "lat": -27.505,
            "lon": 153.1
          },
          {
            "name": "Sunnybank",
            "lat": -27.576,
            "lon": 153.058
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontStyle": "italic",
        "color": "#c9d4ee",
        "stroke": "#0e1a33",
        "strokeWidth": 3,
        "paintOrder": "stroke",
        "align": "left",
        "dx": 7,
        "dy": -7
      },
      "encoding": {
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "text": {
          "field": "name",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lat": -27.4697,
            "lon": 153.0253,
            "t": "Most festivals: Queen Street Mall (5)"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#ffd1e4",
        "stroke": "#0e1a33",
        "strokeWidth": 4,
        "paintOrder": "stroke",
        "strokeJoin": "round",
        "align": "right",
        "dx": -14,
        "dy": -18
      },
      "encoding": {
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    }
  ]
}